rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Lessons Collection: Public read for all students/teachers, validated schema on write
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id', 'title', 'version'])
                   && request.resource.data.version >= 1;
    }

    // 2. Classrooms Collection: Read & write classroom lists and PIN codes
    match /classrooms/{classroomId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id', 'code', 'name'])
                   && request.resource.data.code.size() > 0;
    }

    // 3. Students Collection: Read & write student profiles with required ID
    match /students/{studentId} {
      allow read, write: if studentId != null && studentId.size() > 0;
    }

    // 4. Scores Collection: Read/Write assessment scores with strict boundary checks
    match /scores/{studentId} {
      allow read: if true;
      allow write: if request.resource.data.totalScore <= 100 
                   && request.resource.data.totalScore >= 0
                   && request.resource.data.preTest <= 10 
                   && request.resource.data.preTest >= 0
                   && request.resource.data.postTest <= 10
                   && request.resource.data.postTest >= 0;
    }

    // 5. Progress Collection: Live stage tracking & student XP
    match /progress/{studentId} {
      allow read, write: if studentId != null && studentId.size() > 0;
    }

    // 6. Events & Learning Evidence Collections
    match /events/{eventId} {
      allow read, create: if true;
    }

    match /learningEvidence/{evidenceId} {
      allow read, create: if true;
    }

    // 7. Sessions Management
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // 8. Certificates Verification Metadata
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if request.resource.data.totalScore >= 0;
    }

    // 9. System Configuration & Question Bank
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /questionBank/{questionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
