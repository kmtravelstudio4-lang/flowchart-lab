rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Lessons Collection: Everyone can read, authenticated admin/teacher can write
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true; // In production, restrict to: request.auth != null
    }

    // 2. Students Collection: Students can create/update their own profile
    match /students/{studentId} {
      allow read, write: if true;
    }

    // 3. Scores Collection: Read/Write assessment scores
    match /scores/{studentId} {
      allow read: if true;
      allow write: if request.resource.data.totalScore <= 100 
                   && request.resource.data.preTest <= 10 
                   && request.resource.data.postTest <= 10;
    }

    // 4. Events & Evidence Collections
    match /events/{eventId} {
      allow read, create: if true;
    }

    match /learningEvidence/{evidenceId} {
      allow read, create: if true;
    }

    // 5. System Configuration
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
